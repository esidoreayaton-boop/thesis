# =========================================================
# MySQL Database Credentials for XAMPP / phpMyAdmin
# =========================================================

# Database Host (Default for XAMPP: localhost)
DB_HOST=localhost

# Database Port (Default for MySQL in XAMPP: 3306)
DB_PORT=3306

# Database User (Default for XAMPP phpMyAdmin: root)
DB_USER=root

# Database Password (Default for XAMPP phpMyAdmin: empty string)
DB_PASSWORD=

# Database Name (You can change this to any database name you prefer in phpMyAdmin)
DB_NAME=smart_db

# Express Server Port
PORT=5000

