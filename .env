# =========================================================
# MySQL Database Credentials for XAMPP / phpMyAdmin
# =========================================================

# Database Host (Default for XAMPP: localhost)
DB_HOST=localhost

# Database Port (Default for MySQL in XAMPP: 3306)
DB_PORT=3306

# Database User (Default for XAMPP phpMyAdmin: root)
DB_USER=root

# Database Password (Default for XAMPP phpMyAdmin: empty string)
DB_PASSWORD=

# Database Name (You can change this to any database name you prefer in phpMyAdmin)
DB_NAME=smart_db

# Express Server Port
PORT=5000

# =========================================================
# iProg SMS Gateway API Credentials
# =========================================================
IPROG_SMS_API_TOKEN=7f5d3b5896bd1bb943db25362f59eebed3f557e4
IPROG_SMS_API_URL=https://sms.iprogtech.com/api/v1/sms_messages

# =========================================================
# Email Notification (Gmail SMTP)
# =========================================================
# Step 1: Use your Gmail address below
EMAIL_USER=your_gmail@gmail.com
# Step 2: Generate an App Password at:
#   https://myaccount.google.com/apppasswords
#   (Google Account > Security > 2-Step Verification > App Passwords)
EMAIL_PASS=your_app_password_here
# Sender display name + address (auto-filled from EMAIL_USER if left blank)
EMAIL_FROM="Barangay Pianing System <your_gmail@gmail.com>"
# SMTP settings (Gmail defaults shown – no change needed for Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true

